{
  "name": "afl-liga-app",
  "version": "1.0.0",
  "description": "АФЛ — нативное приложение лиги (Capacitor)",
  "private": true,
  "scripts": {
    "sync": "npx cap sync",
    "copy": "node scripts/copy-www.js",
    "android": "npx cap open android",
    "ios": "npx cap open ios",
    "add:android": "npx cap add android",
    "add:ios": "npx cap add ios",
    "build:android": "npm run copy && npx cap sync android",
    "build:ios": "npm run copy && npx cap sync ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/status-bar": "^6.0.2",
    "@capacitor/splash-screen": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
